# Frontend environment variables
# Copy this file to .env.local and fill in your keys

# Backend API URL (default: local dev server)
VITE_API_URL=http://localhost:8000

# Google Maps JavaScript API key (enables the interactive map)
# Get from: https://console.cloud.google.com (Maps JavaScript API)
VITE_GOOGLE_MAPS_KEY=your-google-maps-api-key-here
