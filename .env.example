# Copy this file to .env and fill in your keys

# LLM — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Web search for agents — get from https://tavily.com
TAVILY_API_KEY=""

# Map visualization — get from https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=""

# App settings
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
